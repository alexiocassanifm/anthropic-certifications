{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/check_verification_age.py\"",
            "timeout": 10,
            "statusMessage": "Checking wiki verification age"
          }
        ]
      }
    ]
  }
}
